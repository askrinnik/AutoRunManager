<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AutoRunManager.Core\AutoRunManager.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Needed by LibraryImport-generated marshalling. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Regenerate with tools/make-icon.ps1. -->
    <ApplicationIcon>AutoRunManager.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <Product>AutoRunManager</Product>
    <Description>Shows and manages the places where Windows starts apps and services automatically.</Description>
  </PropertyGroup>

</Project>
