<Window x:Class="AutoRunManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Startup Manager"
        Width="600"
        MaxHeight="650"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen">
    <Border Background="{StaticResource WindowBackgroundBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1"
            CornerRadius="15"
            Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="5,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="STARTUP MANAGER"
                           Foreground="{StaticResource AccentBrush}"
                           FontFamily="{StaticResource UiFont}"
                           FontSize="16"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           MouseLeftButtonDown="OnTitleMouseLeftButtonDown" />
                <TextBlock Grid.Column="1"
                           Text="r"
                           FontFamily="Marlett"
                           FontSize="16"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Cursor="Hand"
                           VerticalAlignment="Center"
                           ToolTip="Close"
                           MouseLeftButtonDown="OnCloseMouseLeftButtonDown" />
            </Grid>

            <TextBlock Grid.Row="1"
                       Text="Nothing here yet."
                       Foreground="{StaticResource SecondaryTextBrush}"
                       FontFamily="{StaticResource UiFont}"
                       FontSize="13"
                       HorizontalAlignment="Center"
                       Margin="0,20" />
        </Grid>
    </Border>
</Window>
