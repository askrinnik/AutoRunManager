<Window x:Class="AutoRunManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AutoRunManager.ViewModels"
        Title="Startup Manager"
        Width="820"
        Height="650"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        MinWidth="600"
        MinHeight="360"
        WindowStartupLocation="CenterScreen">
    <!-- Borderless but resizable from every edge; the header is the drag handle. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="15" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- One entry: icon, name (opens its location), command (shows the file), switch, delete. -->
        <DataTemplate x:Key="EntryCard" DataType="{x:Type vm:EntryViewModel}">
            <Border Background="{StaticResource CardBrush}" CornerRadius="10" Margin="5" Padding="12" ToolTip="{Binding Tooltip}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="36" Height="36" Background="{StaticResource IconBackgroundBrush}" CornerRadius="8" Margin="0,0,15,0" VerticalAlignment="Center">
                        <Image Width="22" Height="22" Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <!-- Left-aligned grid: a long name is trimmed and the scope tag stays right after it. -->
                        <Grid HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource LinkText}" Foreground="{StaticResource TextBrush}"
                                       FontFamily="{StaticResource UiFont}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Left"
                                       TextTrimming="CharacterEllipsis" ToolTip="Open where it is defined">
                                <TextBlock.InputBindings>
                                    <MouseBinding Gesture="LeftClick" Command="{Binding OpenLocationCommand}" />
                                </TextBlock.InputBindings>
                            </TextBlock>
                            <Border Grid.Column="1" Style="{StaticResource ScopeTag}">
                                <TextBlock Text="{Binding Scope}" FontFamily="{StaticResource UiFont}" FontSize="10" Foreground="{StaticResource HeaderTextBrush}" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding PathText}" Style="{StaticResource LinkText}" Foreground="{StaticResource SecondaryTextBrush}"
                                   FontFamily="{StaticResource PathFont}" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Left"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Entry.Command}">
                            <TextBlock.InputBindings>
                                <MouseBinding Gesture="LeftClick" Command="{Binding ShowFileCommand}" />
                            </TextBlock.InputBindings>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Style="{StaticResource ToggleSwitch}" Margin="12,0,12,0"
                                  IsChecked="{Binding IsEnabled, Mode=OneWay}" Command="{Binding ToggleCommand}"
                                  IsEnabled="{Binding CanChange}" ToolTip="{Binding ToggleTooltip}" ToolTipService.ShowOnDisabled="True"
                                  Visibility="{Binding ShowToggle, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="read-only" FontFamily="{StaticResource UiFont}" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}"
                                   Opacity="0.7" Margin="12,0,12,0" VerticalAlignment="Center" ToolTip="Windows has no switch for this entry; open its location or delete it">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowToggle}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Grid Width="14">
                            <TextBlock Text="r" FontFamily="Marlett" FontSize="14" Cursor="Hand"
                                       IsEnabled="{Binding CanChange}" ToolTip="{Binding DeleteTooltip}" ToolTipService.ShowOnDisabled="True"
                                       Visibility="{Binding ShowDelete, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.35" />
                                                <Setter Property="Cursor" Value="Arrow" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                                <TextBlock.InputBindings>
                                    <MouseBinding Gesture="LeftClick" Command="{Binding DeleteCommand}" />
                                </TextBlock.InputBindings>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- A section: separator (not before the first), clickable header, cards. -->
        <DataTemplate x:Key="SectionTemplate" DataType="{x:Type vm:SectionViewModel}">
            <StackPanel>
                <Border Height="1" Background="{StaticResource SecondaryTextBrush}" Margin="0,15,0,10" Opacity="0.2">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <TextBlock Text="{Binding Title}" FontFamily="{StaticResource UiFont}" FontSize="12" FontWeight="Bold"
                           Margin="5,4,0,5" HorizontalAlignment="Left" ToolTip="{Binding HeaderTooltip}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource HeaderTextBrush}" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasToggles}" Value="True" />
                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    <Setter Property="Cursor" Value="Hand" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                    <TextBlock.InputBindings>
                        <MouseBinding Gesture="LeftClick" Command="{Binding ToggleAllCommand}" />
                    </TextBlock.InputBindings>
                </TextBlock>
                <ItemsControl ItemsSource="{Binding Entries}" ItemTemplate="{StaticResource EntryCard}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Border Background="{StaticResource WindowBackgroundBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1"
            CornerRadius="15"
            Padding="20,20,20,12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: title (drag handle), restart as admin, refresh, close. -->
            <Grid Margin="5,0,0,14" Background="Transparent" MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="STARTUP MANAGER" Foreground="{StaticResource AccentBrush}" FontFamily="{StaticResource UiFont}"
                           FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,-5,5,0">
                    <Border CornerRadius="9" Padding="9,2" Margin="0,0,14,0" Cursor="Hand" VerticalAlignment="Center"
                            Visibility="{Binding ShowRestartAsAdmin, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="Restart elevated to change machine-wide entries, services and tasks of other users">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource IconBackgroundBrush}" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding RestartAsAdminCommand}" />
                        </Border.InputBindings>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEA18;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource TextBrush}"
                                       VerticalAlignment="Center" Margin="0,1,5,0" />
                            <TextBlock Text="Restart as admin" FontFamily="{StaticResource UiFont}" FontSize="11" Foreground="{StaticResource TextBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Width="1" Height="14" Background="{StaticResource SecondaryTextBrush}" Opacity="0.4" Margin="0,0,10,0" />
                    <TextBlock Text="&#x21BB;" FontSize="20" FontWeight="Bold" Margin="0,-6,15,0" ToolTip="Reload">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource HeaderGlyph}">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource RefreshHoverBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <TextBlock.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding RefreshCommand}" />
                        </TextBlock.InputBindings>
                    </TextBlock>
                    <TextBlock Text="r" FontFamily="Marlett" FontSize="16" ToolTip="Close" MouseLeftButtonDown="OnCloseClick">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource HeaderGlyph}">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Side navigation: groups and their sections; dimmed while a search spans all groups. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,14,0">
                    <ListBox ItemsSource="{Binding Navigation}" SelectedItem="{Binding SelectedNavigation}"
                             ItemContainerStyle="{StaticResource NavigationItemStyle}">
                        <ListBox.Style>
                            <Style TargetType="ListBox" BasedOn="{StaticResource BareListBox}">
                                <Setter Property="ItemsPanel">
                                    <Setter.Value>
                                        <ItemsPanelTemplate>
                                            <StackPanel />
                                        </ItemsPanelTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSearching}" Value="True">
                                        <Setter Property="Opacity" Value="0.45" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                    </ListBox>
                </ScrollViewer>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Search (all groups) and filter -->
                    <Grid Margin="5,0,5,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" Tag="Search all entries  (Ctrl+F)"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
                        <ListBox Grid.Column="1" Style="{StaticResource BareListBox}" ItemContainerStyle="{StaticResource ChipItemStyle}"
                                 ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </Grid>

                    <!-- Entries -->
                    <ScrollViewer x:Name="EntriesScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden" ScrollChanged="OnEntriesScrollChanged">
                        <ItemsControl ItemsSource="{Binding Sections}" ItemTemplate="{StaticResource SectionTemplate}" />
                    </ScrollViewer>
                    <TextBlock Grid.Row="1" Text="Loading..." Foreground="{StaticResource SecondaryTextBrush}" FontFamily="{StaticResource UiFont}"
                               FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                    <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="10" Margin="5,15,5,5" Padding="20" VerticalAlignment="Top"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding EmptyText}" Foreground="{StaticResource SecondaryTextBrush}" FontFamily="{StaticResource UiFont}"
                                   FontSize="13" HorizontalAlignment="Center" Opacity="0.6" />
                    </Border>
                </Grid>
            </Grid>

            <!-- Status -->
            <TextBlock Grid.Row="2" Text="{Binding Status}" Foreground="{StaticResource SecondaryTextBrush}" FontFamily="{StaticResource UiFont}"
                       FontSize="10" Margin="5,8,5,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" />
        </Grid>
    </Border>
</Window>
