<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Palette of the PowerShell prototype. -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#141619" />
    <SolidColorBrush x:Key="CardBrush" Color="#1E2228" />
    <SolidColorBrush x:Key="IconBackgroundBrush" Color="#3D4450" />
    <SolidColorBrush x:Key="AccentBrush" Color="#5E81AC" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#4C566A" />
    <SolidColorBrush x:Key="RefreshHoverBrush" Color="#EBCB8B" />
    <SolidColorBrush x:Key="TextBrush" Color="White" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="Gray" />
    <SolidColorBrush x:Key="HeaderTextBrush" Color="LightGray" />
    <SolidColorBrush x:Key="DangerBrush" Color="IndianRed" />

    <FontFamily x:Key="UiFont">Bahnschrift</FontFamily>
    <FontFamily x:Key="PathFont">Consolas</FontFamily>
</ResourceDictionary>
