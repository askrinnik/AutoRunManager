<Window x:Class="AutoRunManager.Dialogs.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="320"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Border Background="{StaticResource WindowBackgroundBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="20,22,20,18">
        <StackPanel>
            <TextBlock x:Name="MessageText"
                       Foreground="{StaticResource TextBrush}"
                       FontFamily="{StaticResource UiFont}"
                       FontSize="12"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,0,18" />
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <Button x:Name="YesButton" Content="YES" Style="{StaticResource AccentButton}" Margin="0,0,5,0" Click="OnYes" IsDefault="True" />
                <Button x:Name="NoButton" Content="NO" Style="{StaticResource AccentButton}" Margin="5,0,0,0" Click="OnNo" IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
